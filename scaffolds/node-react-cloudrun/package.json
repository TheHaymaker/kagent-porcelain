{
  "name": "workbench-app",
  "version": "0.1.0",
  "description": "Internal app built from the node-react-cloudrun golden path: React (Vite) UI + small Express API on Cloud Run behind IAP",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "LOCAL_DEV_USER=${LOCAL_DEV_USER:-dev@example.com} node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "check": "node --check server/index.js && vite build --logLevel error"
  },
  "dependencies": {
    "express": "^5.1.0",
    "google-auth-library": "^10.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "supertest": "^7.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
