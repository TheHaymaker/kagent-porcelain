server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Runtime configuration, mounted from a ConfigMap; never cached.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        try_files /config.json =404;
    }

    # gRPC-Web and A2A to the Workbench server. Responses stream (a chat
    # turn can run for minutes), so nothing is buffered and timeouts are long.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 20m;
        # Every API request counts as activity for the waker, which pauses the
        # cluster's workload nodes after an idle hour (WAKER_ACTIVITY; without
        # the waker it answers 204 here).
        mirror /__waker/activity;
        mirror_request_body off;
        # The server cannot be reached (its nodes are paused or starting):
        # the waker starts them and answers 503 with a message the app shows.
        proxy_connect_timeout 5s;
        error_page 502 504 = @starting;
    }

    location = /__waker/activity {
        internal;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        ${WAKER_ACTIVITY}
    }

    location @starting {
        ${WAKER_STARTING}
    }

    # Google Identity Platform's sign-in handler, served from this host so the
    # sign-in popup and the app share one site. Browsers partition a
    # cross-site handler's storage, and the popup's result never arrives
    # (auth/popup-closed-by-user). AUTH_HANDLER_UPSTREAM is
    # https://<project>.firebaseapp.com; the image's default points nowhere useful.
    location /__/ {
        proxy_pass ${AUTH_HANDLER_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_http_version 1.1;
        # The SDK loads /__/auth/iframe inside the app, so this path may be
        # framed by this site (only). add_header here replaces the server's.
        proxy_hide_header X-Frame-Options;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: every other path is the app.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
