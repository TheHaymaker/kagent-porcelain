server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Runtime configuration, mounted from a ConfigMap; never cached.
    location = /config.json {
        add_header Cache-Control "no-store" always;
        try_files /config.json =404;
    }

    # gRPC-Web and A2A to the Workbench server. Responses stream (a chat
    # turn can run for minutes), so nothing is buffered and timeouts are long.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 20m;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: every other path is the app.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
