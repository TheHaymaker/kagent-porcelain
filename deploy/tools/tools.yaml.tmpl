spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: cloudrun-mcp}
  template:
    metadata:
      labels: {app.kubernetes.io/name: cloudrun-mcp, app.kubernetes.io/part-of: workbench}
