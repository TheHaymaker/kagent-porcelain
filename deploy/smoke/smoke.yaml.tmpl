# The end-to-end smoke test's agent: a scripted model that always asks for a
# production deploy, bound to Workbench's own tools on kagent's /mcp endpoint
# with requireApproval, so every tool call pauses as a kagent HITL request.
# Rendered by deploy/gcp/up.sh (Python string.Template): ${NAMESPACE} ${MOCKLLM_IMAGE}
# ${CONTROL_PLANE_URL}. It lives in kagent's namespace so it can use the
# kagent-default Harness, which Agents reference by local name.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: workbench-mockllm
  namespace: ${NAMESPACE}
  labels: {app.kubernetes.io/name: workbench-mockllm, app.kubernetes.io/part-of: workbench-smoke}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: workbench-mockllm}
  template:
    metadata:
      labels: {app.kubernetes.io/name: workbench-mockllm, app.kubernetes.io/part-of: workbench-smoke}
    spec:
      containers:
        - name: model
          image: ${MOCKLLM_IMAGE}
          ports: [{containerPort: 8080}]
          readinessProbe:
            httpGet: {path: /health, port: 8080}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: workbench-mockllm
  namespace: ${NAMESPACE}
spec:
  selector: {app.kubernetes.io/name: workbench-mockllm}
  ports: [{port: 8080, targetPort: 8080}]
---
apiVersion: v1
kind: Secret
metadata:
  name: workbench-smoke-model
  namespace: ${NAMESPACE}
stringData:
  OPENAI_API_KEY: not-a-real-key
---
apiVersion: api.kagent.dev/v1alpha3
kind: ModelConfig
metadata:
  name: workbench-smoke
  namespace: ${NAMESPACE}
spec:
  provider: OpenAI
  model: workbench-smoke
  apiKeySecret: workbench-smoke-model
  apiKeySecretKey: OPENAI_API_KEY
  openAI:
    baseUrl: http://workbench-mockllm.${NAMESPACE}.svc.cluster.local:8080/v1
---
# Workbench's tools. The URL's origin is kagent's control-plane URL, for
# which Substrate replaces the Authorization header with the Actor's runtime
# token; the literal value is only a placeholder for it to replace.
apiVersion: api.kagent.dev/v1alpha3
kind: RemoteMCPServer
metadata:
  name: workbench-api
  namespace: ${NAMESPACE}
spec:
  description: Workbench tools (smoke test binding)
  protocol: STREAMABLE_HTTP
  url: ${CONTROL_PLANE_URL}/mcp
  headersFrom:
    - name: Authorization
      value: "Bearer kagent-credential-injected"
---
apiVersion: api.kagent.dev/v1alpha3
kind: AgentTemplate
metadata:
  name: workbench-smoke
  namespace: ${NAMESPACE}
spec:
  description: Workbench end-to-end smoke test agent
  modelConfig: {name: workbench-smoke}
  systemPrompt: Use the Workbench tools as asked.
  tools:
    - mcp:
        server: {kind: RemoteMCPServer, name: workbench-api}
        requireApproval: true
---
apiVersion: api.kagent.dev/v1alpha3
kind: Agent
metadata:
  name: workbench-smoke
  namespace: ${NAMESPACE}
spec:
  template:
    ref: {name: workbench-smoke}
  harnessRef: {name: kagent-default}
